{
  "name": "reskin",
  "private": true,
  "version": "1.0.0",
  "description": "A floating box that turns any desktop icon into an editable canvas.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/third-party-notices.mjs --if-tauri",
    "preview": "vite preview --port 1420 --strictPort",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run && node --test \"scripts/*.test.mjs\"",
    "e2e": "playwright test",
    "docs:screenshots": "node -e \"const r = require('node:child_process').spawnSync('playwright test e2e/docs-screenshots.spec.ts', { stdio: 'inherit', shell: true, env: { ...process.env, RESKIN_DOCS_SCREENSHOTS: '1' } }); process.exit(r.status ?? 1)\"",
    "tauri": "tauri",
    "bundle:budget": "node scripts/check-bundle-budget.mjs",
    "notices": "node scripts/third-party-notices.mjs",
    "bindings": "cargo test -p reskin-core --features ts export_bindings"
  },
  "dependencies": {
    "@lucide/svelte": "1.47.0",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "@tauri-apps/plugin-opener": "2.5.5"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.11.5",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "22.20.4",
    "@types/pngjs": "6.0.5",
    "pngjs": "7.0.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "tslib": "2.8.1",
    "typescript": "~5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
