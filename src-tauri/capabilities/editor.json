{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "editor",
  "description": "The icon editor window.",
  "windows": ["editor"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "allow-app-boot",
    "allow-open-editor",
    "allow-editor-next",
    "allow-editor-ack",
    "allow-editor-close",
    "allow-inspect-paths",
    "allow-inspect-system-icon",
    "allow-item-frames",
    "allow-pick-files",
    "allow-read-project",
    "allow-apply-icon",
    "allow-apply-icon-elevated",
    "allow-restore",
    "allow-history-list",
    "allow-refresh-icons",
    "allow-export-file",
    "allow-library-list",
    "allow-library-save",
    "allow-library-load",
    "allow-library-delete",
    "allow-autosave",
    "allow-autosave-load",
    "allow-wallpaper",
    "allow-wallpaper-info",
    "allow-system-fonts",
    "allow-accent-color",
    "allow-settings-get",
    "allow-settings-set",
    "allow-open-external",
    "allow-set-box-visible",
    "allow-quit-app",
    "allow-smoke-ready"
  ]
}
