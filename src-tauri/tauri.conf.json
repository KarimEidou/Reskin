{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Reskin",
  "mainBinaryName": "reskin",
  "version": "1.0.0",
  "identifier": "com.karimeidou.reskin",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "box",
        "create": false,
        "url": "box.html",
        "title": "Reskin",
        "width": 148,
        "height": 148,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": true,
        "dragDropEnabled": true,
        "backgroundColor": [0, 0, 0, 0]
      },
      {
        "label": "editor",
        "create": false,
        "url": "editor.html",
        "title": "Reskin",
        "width": 1080,
        "height": 720,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "dragDropEnabled": true,
        "backgroundColor": [0, 0, 0, 0]
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "media-src": "'self' data: blob:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "freezePrototype": false,
      "capabilities": ["box", "editor"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Karim Eidou",
    "copyright": "© 2026 Karim Eidou. MIT License.",
    "category": "Utility",
    "shortDescription": "Reskin any desktop icon",
    "longDescription": "Reskin is a small floating box for your desktop. Drag a shortcut onto it, redesign its icon in a full editor, and apply it with one click.",
    "homepage": "https://github.com/KarimEidou/Reskin",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./windows/hooks.nsh"
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
